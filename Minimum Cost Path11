#include <bits/stdc++.h>
using namespace std;

int main() {
    ios::sync_with_stdio(false);
    cin.tie(nullptr);

    int n, m;
    cin >> n >> m;

    vector<vector<long long>> grid(n, vector<long long>(m));

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < m; j++) {
            cin >> grid[i][j];
        }
    }

    vector<vector<long long>> dp(n, vector<long long>(m));

    dp[0][0] = grid[0][0];

    for (int i = 0; i < n; i++) {
        for (int j = 0; j < m; j++) {
            if (i == 0 && j == 0)
                continue;

            long long best = LLONG_MAX;

            if (i > 0)
                best = min(best, dp[i - 1][j]);

            if (j > 0)
                best = min(best, dp[i][j - 1]);

            if (i > 0 && j > 0)
                best = min(best, dp[i - 1][j - 1]);

            dp[i][j] = grid[i][j] + best;
        }
    }

    cout << dp[n - 1][m - 1] << '\n';

    return 0;
}
