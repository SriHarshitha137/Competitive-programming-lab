#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cin >> n;

    vector<int> a(n);
    int total = 0;

    for (int &x : a) {
        cin >> x;
        total += x;
    }

    int n1 = n / 2;
    int n2 = n - n1;

    vector<vector<int>> left(n1 + 1), right(n2 + 1);

    for (int mask = 0; mask < (1 << n1); mask++) {
        int cnt = 0, sum = 0;
        for (int i = 0; i < n1; i++) {
            if (mask & (1 << i)) {
                cnt++;
                sum += a[i];
            }
        }
        left[cnt].push_back(sum);
    }

    for (int mask = 0; mask < (1 << n2); mask++) {
        int cnt = 0, sum = 0;
        for (int i = 0; i < n2; i++) {
            if (mask & (1 << i)) {
                cnt++;
                sum += a[n1 + i];
            }
        }
        right[cnt].push_back(sum);
    }

    for (auto &v : right)
        sort(v.begin(), v.end());

    int ans = INT_MAX;

    vector<int> required;

    if (n % 2 == 0)
        required = {n / 2};
    else
        required = {n / 2, n / 2 + 1};

    for (int need : required) {
        for (int cnt = 0; cnt <= n1; cnt++) {
            int other = need - cnt;

            if (other < 0 || other > n2)
                continue;

            for (int sum1 : left[cnt]) {
                int target = total / 2 - sum1;

                auto it = lower_bound(right[other].begin(),
                                      right[other].end(),
                                      target);

                if (it != right[other].end()) {
                    int groupSum = sum1 + *it;
                    ans = min(ans, abs(total - 2 * groupSum));
                }

                if (it != right[other].begin()) {
                    --it;
                    int groupSum = sum1 + *it;
                    ans = min(ans, abs(total - 2 * groupSum));
                }
            }
        }
    }

    cout << ans << '\n';

    return 0;
}
